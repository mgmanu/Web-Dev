const STORAGE_KEY = "ticketBookings";
const SESSION_KEY = "bookingState";

const standPrices = {
    General: 500,
    Premium: 1000,
    VIP: 2000,
    Corporate: 3500
};

const standDetails = {
    General: {
        title: "General Stand",
        description: "Comfortable seating with a clear view of the match."
    },
    Premium: {
        title: "Premium Stand",
        description: "Better seating position with improved match visibility."
    },
    VIP: {
        title: "VIP Stand",
        description: "Premium seating with enhanced comfort and exclusive access."
    },
    Corporate: {
        title: "Corporate Stand",
        description: "Luxury seating with premium hospitality and services."
    }
};

const matchDetails = {
    "India vs Australia": {
        date: "25 OCT 2026",
        time: "7:30 PM",
        venue: "National Stadium"
    },
    "India vs England": {
        date: "28 OCT 2026",
        time: "7:30 PM",
        venue: "National Stadium"
    },
    "India vs South Africa": {
        date: "01 NOV 2026",
        time: "7:30 PM",
        venue: "National Stadium"
    }
};

const bookingForm = document.getElementById("bookingForm");
const nameInput = document.getElementById("name");
const emailInput = document.getElementById("email");
const phoneInput = document.getElementById("phone");
const matchSelect = document.getElementById("match");
const standSelect = document.getElementById("stand");
const quantityInput = document.getElementById("quantity");

const decreaseBtn = document.getElementById("decrease");
const increaseBtn = document.getElementById("increase");

const matchDate = document.getElementById("matchDate");
const matchTime = document.getElementById("matchTime");
const matchVenue = document.getElementById("matchVenue");

const summaryMatch = document.getElementById("summaryMatch");
const summaryStand = document.getElementById("summaryStand");
const summaryTickets = document.getElementById("summaryTickets");
const summaryPrice = document.getElementById("summaryPrice");
const summaryDiscount = document.getElementById("summaryDiscount");
const summaryTotal = document.getElementById("summaryTotal");

const standTitle = document.getElementById("standTitle");
const standDescription = document.getElementById("standDescription");

const successMessage = document.getElementById("successMessage");

const matchFilter = document.getElementById("matchFilter");
const standFilter = document.getElementById("standFilter");
const bookingsTableBody = document.getElementById("bookingsTableBody");

function getBookings() {
    const bookings = localStorage.getItem(STORAGE_KEY);

    if (!bookings) {
        return [];
    }

    try {
        return JSON.parse(bookings);
    } catch (error) {
        return [];
    }
}

function saveBookings(bookings) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(bookings));
}

function saveSession() {
    const state = {
        name: nameInput.value,
        email: emailInput.value,
        phone: phoneInput.value,
        match: matchSelect.value,
        stand: standSelect.value,
        quantity: quantityInput.value
    };

    sessionStorage.setItem(SESSION_KEY, JSON.stringify(state));
}

function loadSession() {
    const savedState = sessionStorage.getItem(SESSION_KEY);

    if (!savedState) {
        return;
    }

    try {
        const state = JSON.parse(savedState);

        nameInput.value = state.name || "";
        emailInput.value = state.email || "";
        phoneInput.value = state.phone || "";
        matchSelect.value = state.match || "";
        standSelect.value = state.stand || "";
        quantityInput.value = state.quantity || 1;

        updateMatchInformation();
        updateSummary();
    } catch (error) {
        sessionStorage.removeItem(SESSION_KEY);
    }
}

function showError(input, message) {
    const errorElement = document.getElementById(input.id + "Error");

    input.classList.add("invalid");

    if (errorElement) {
        errorElement.textContent = message;
    }
}

function clearError(input) {
    const errorElement = document.getElementById(input.id + "Error");

    input.classList.remove("invalid");

    if (errorElement) {
        errorElement.textContent = "";
    }
}

function validateName() {
    const name = nameInput.value.trim();

    if (name === "") {
        showError(nameInput, "Name is required.");
        return false;
    }

    if (name.length < 3) {
        showError(nameInput, "Name must contain at least 3 characters.");
        return false;
    }

    clearError(nameInput);
    return true;
}

function validateEmail() {
    const email = emailInput.value.trim();
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    if (email === "") {
        showError(emailInput, "Email is required.");
        return false;
    }

    if (!emailPattern.test(email)) {
        showError(emailInput, "Enter a valid email address.");
        return false;
    }

    clearError(emailInput);
    return true;
}

function validatePhone() {
    const phone = phoneInput.value.trim();
    const phonePattern = /^[6-9][0-9]{9}$/;

    if (phone === "") {
        showError(phoneInput, "Phone number is required.");
        return false;
    }

    if (!phonePattern.test(phone)) {
        showError(phoneInput, "Enter a valid 10-digit phone number.");
        return false;
    }

    clearError(phoneInput);
    return true;
}

function validateMatch() {
    if (matchSelect.value === "") {
        showError(matchSelect, "Please select a match.");
        return false;
    }

    clearError(matchSelect);
    return true;
}

function validateStand() {
    if (standSelect.value === "") {
        showError(standSelect, "Please select a stand.");
        return false;
    }

    clearError(standSelect);
    return true;
}

function validateQuantity() {
    const quantity = Number(quantityInput.value);

    if (quantity < 1 || quantity > 10 || !Number.isInteger(quantity)) {
        showError(quantityInput, "Tickets must be between 1 and 10.");
        return false;
    }

    clearError(quantityInput);
    return true;
}

function validateForm() {
    const nameValid = validateName();
    const emailValid = validateEmail();
    const phoneValid = validatePhone();
    const matchValid = validateMatch();
    const standValid = validateStand();
    const quantityValid = validateQuantity();

    return (
        nameValid &&
        emailValid &&
        phoneValid &&
        matchValid &&
        standValid &&
        quantityValid
    );
}

function updateMatchInformation() {
    const selectedMatch = matchSelect.value;

    if (!selectedMatch || !matchDetails[selectedMatch]) {
        matchDate.textContent = "-";
        matchTime.textContent = "-";
        matchVenue.textContent = "-";
        return;
    }

    const details = matchDetails[selectedMatch];

    matchDate.textContent = details.date;
    matchTime.textContent = details.time;
    matchVenue.textContent = details.venue;
}

function calculateBooking() {
    const stand = standSelect.value;
    const quantity = Number(quantityInput.value) || 0;

    const pricePerTicket = standPrices[stand] || 0;
    const subtotal = pricePerTicket * quantity;

    let discountPercentage = 0;

    if (quantity >= 5) {
        discountPercentage = 10;
    } else if (quantity >= 3) {
        discountPercentage = 5;
    }

    const discountAmount = subtotal * discountPercentage / 100;
    const total = subtotal - discountAmount;

    return {
        pricePerTicket,
        quantity,
        subtotal,
        discountPercentage,
        discountAmount,
        total
    };
}

function updateSummary() {
    const selectedMatch = matchSelect.value;
    const selectedStand = standSelect.value;

    const booking = calculateBooking();

    summaryMatch.textContent = selectedMatch || "-";
    summaryStand.textContent = selectedStand || "-";
    summaryTickets.textContent = booking.quantity;
    summaryPrice.textContent = "₹" + booking.pricePerTicket.toLocaleString("en-IN");
    summaryDiscount.textContent =
        booking.discountPercentage + "%";

    summaryTotal.textContent =
        "₹" + booking.total.toLocaleString("en-IN");

    if (selectedStand && standDetails[selectedStand]) {
        standTitle.textContent = standDetails[selectedStand].title;
        standDescription.textContent =
            standDetails[selectedStand].description;
    } else {
        standTitle.textContent = "Select a stand";
        standDescription.textContent =
            "Select a stand to view the available information.";
    }
}

function generateBookingId() {
    const timestamp = Date.now();
    const randomNumber = Math.floor(1000 + Math.random() * 9000);

    return "SX-" + timestamp + "-" + randomNumber;
}

function createBooking() {
    const booking = calculateBooking();

    return {
        bookingId: generateBookingId(),
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        phone: phoneInput.value.trim(),
        match: matchSelect.value,
        stand: standSelect.value,
        tickets: booking.quantity,
        total: booking.total,
        date: new Date().toLocaleDateString("en-IN")
    };
}

function addBooking(booking) {
    const bookings = getBookings();

    bookings.push(booking);

    saveBookings(bookings);
}

function displayBookings(bookings) {
    bookingsTableBody.innerHTML = "";

    if (bookings.length === 0) {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td colspan="7">No bookings found.</td>
        `;

        bookingsTableBody.appendChild(row);
        return;
    }

    bookings.forEach(function (booking) {
        const row = document.createElement("tr");

        row.innerHTML = `
            <td>${booking.bookingId}</td>
            <td>${booking.name}</td>
            <td>${booking.match}</td>
            <td>${booking.stand}</td>
            <td>${booking.tickets}</td>
            <td>₹${Number(booking.total).toLocaleString("en-IN")}</td>
            <td>${booking.date}</td>
        `;

        bookingsTableBody.appendChild(row);
    });
}

function filterBookings() {
    const selectedMatch = matchFilter.value;
    const selectedStand = standFilter.value;

    const bookings = getBookings();

    const filteredBookings = bookings.filter(function (booking) {
        const matchMatches =
            selectedMatch === "" ||
            booking.match === selectedMatch;

        const standMatches =
            selectedStand === "" ||
            booking.stand === selectedStand;

        return matchMatches && standMatches;
    });

    displayBookings(filteredBookings);
}

function selectMatch(selectedMatch) {
    matchSelect.value = selectedMatch;

    updateMatchInformation();
    updateSummary();

    document.getElementById("book").scrollIntoView({
        behavior: "smooth"
    });

    saveSession();
}

function handleBookingSubmit(event) {
    event.preventDefault();

    if (!validateForm()) {
        return;
    }

    const booking = createBooking();

    addBooking(booking);

    displayBookings(getBookings());

    successMessage.textContent =
        "Booking confirmed successfully. Your Booking ID is " +
        booking.bookingId;

    successMessage.classList.add("show");

    sessionStorage.removeItem(SESSION_KEY);

    bookingForm.reset();

    quantityInput.value = 1;

    updateMatchInformation();
    updateSummary();

    window.setTimeout(function () {
        successMessage.classList.remove("show");
    }, 5000);

    document.getElementById("bookings").scrollIntoView({
        behavior: "smooth"
    });
}

nameInput.addEventListener("input", function () {
    validateName();
    saveSession();
});

emailInput.addEventListener("input", function () {
    validateEmail();
    saveSession();
});

phoneInput.addEventListener("input", function () {
    validatePhone();
    saveSession();
});

matchSelect.addEventListener("change", function () {
    validateMatch();
    updateMatchInformation();
    updateSummary();
    saveSession();
});

standSelect.addEventListener("change", function () {
    validateStand();
    updateSummary();
    saveSession();
});

quantityInput.addEventListener("input", function () {
    validateQuantity();

    let quantity = Number(quantityInput.value);

    if (quantity < 1) {
        quantity = 1;
    }

    if (quantity > 10) {
        quantity = 10;
    }

    quantityInput.value = quantity;

    updateSummary();
    saveSession();
});

decreaseBtn.addEventListener("click", function () {
    let quantity = Number(quantityInput.value) || 1;

    if (quantity > 1) {
        quantity--;
    }

    quantityInput.value = quantity;

    validateQuantity();
    updateSummary();
    saveSession();
});

increaseBtn.addEventListener("click", function () {
    let quantity = Number(quantityInput.value) || 1;

    if (quantity < 10) {
        quantity++;
    }

    quantityInput.value = quantity;

    validateQuantity();
    updateSummary();
    saveSession();
});

matchFilter.addEventListener("change", filterBookings);
standFilter.addEventListener("change", filterBookings);

bookingForm.addEventListener("submit", handleBookingSubmit);

document.querySelectorAll(".schedule-btn").forEach(function (button) {
    button.addEventListener("click", function () {
        const selectedMatch = button.dataset.match;

        selectMatch(selectedMatch);
    });
});

displayBookings(getBookings());
loadSession();
updateMatchInformation();
updateSummary();